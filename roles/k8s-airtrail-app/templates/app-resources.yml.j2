---
# Deployment do AirTrail
apiVersion: apps/v1
kind: Deployment
metadata:
  name: airtrail-app-deployment
spec:
  replicas: {{ app_replicas }}
  selector:
    matchLabels:
      app: airtrail-app
  template:
    metadata:
      labels:
        app: airtrail-app
    spec:
      containers:
        - name: airtrail
          image: johly/airtrail:latest
          ports:
            - containerPort: {{ app_container_port }}
          # --- OTIMIZAÇÃO: RESOURCE LIMITS ---
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
            limits:
              cpu: "500m"
              memory: "512Mi"
          # --- OTIMIZAÇÃO: HEALTH PROBES ---
          livenessProbe:
            httpGet:
              path: /
              port: {{ app_container_port }}
            initialDelaySeconds: 30
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /
              port: {{ app_container_port }}
            initialDelaySeconds: 5
            periodSeconds: 10
          env:
            - name: DB_URL
              value: "postgresql://{{ db_user }}:{{ db_password }}@airtrail-db-svc:5432/{{ db_name }}"
---
# Service LoadBalancer (público)
apiVersion: v1
kind: Service
metadata:
  name: airtrail-app-svc
spec:
  selector:
    app: airtrail-app
  ports:
    - protocol: TCP
      port: 80
      targetPort: {{ app_container_port }}
  type: LoadBalancer
---
# --- OTIMIZAÇÃO: HORIZONTAL POD AUTOSCALER ---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: airtrail-app-hpa
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: airtrail-app-deployment
  minReplicas: {{ hpa_min_replicas }}
  maxReplicas: {{ hpa_max_replicas }}
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: {{ hpa_cpu_target }}