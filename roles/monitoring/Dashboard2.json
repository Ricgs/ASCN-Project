{
  "displayName": "AirTrail - Monitoring Dashboard 2",
  "mosaicLayout": {
    "columns": 48,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 24,
        "height": 14,
        "widget": {
          "title": "AirTrail - CPU request utilization [MEAN]",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"kubernetes.io/container/cpu/request_utilization\" resource.type=\"k8s_container\" resource.label.\"project_id\"=\"ascn-25-26\" resource.label.\"cluster_name\"=\"ascn-cluster\" resource.label.\"namespace_name\"=\"default\" resource.label.\"container_name\"=\"airtrail\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_MEAN"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 0,
        "width": 24,
        "height": 14,
        "widget": {
          "title": "AirTrail - Total memory used (all replicas) [SUM]",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"kubernetes.io/container/memory/used_bytes\" resource.type=\"k8s_container\" resource.label.\"project_id\"=\"ascn-25-26\" resource.label.\"cluster_name\"=\"ascn-cluster\" resource.label.\"namespace_name\"=\"default\" resource.label.\"container_name\"=\"airtrail\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 14,
        "width": 24,
        "height": 10,
        "widget": {
          "title": "AirTrail - Number of replicas (containers) [COUNT]",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "minAlignmentPeriod": "60s",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"kubernetes.io/container/uptime\" resource.type=\"k8s_container\" resource.label.\"project_id\"=\"ascn-25-26\" resource.label.\"cluster_name\"=\"ascn-cluster\" resource.label.\"namespace_name\"=\"default\" resource.label.\"container_name\"=\"airtrail\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_COUNT"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 14,
        "width": 24,
        "height": 10,
        "widget": {
          "title": "GKE Nodes - Network throughput in/out [SUM]",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"compute.googleapis.com/instance/network/received_bytes_count\" resource.type=\"gce_instance\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                }
              },
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"compute.googleapis.com/instance/network/sent_bytes_count\" resource.type=\"gce_instance\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 24,
        "width": 24,
        "height": 10,
        "widget": {
          "title": "AirTrail - Container restart count [SUM]",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"kubernetes.io/container/restart_count\" resource.type=\"k8s_container\" resource.label.\"project_id\"=\"ascn-25-26\" resource.label.\"cluster_name\"=\"ascn-cluster\" resource.label.\"namespace_name\"=\"default\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      {
        "xPos": 24,
        "yPos": 24,
        "width": 24,
        "height": 10,
        "widget": {
          "title": "Logging - Throughput [bytes/sec]",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"logging.googleapis.com/byte_count\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_RATE",
                      "crossSeriesReducer": "REDUCE_SUM"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    ]
  }
}
